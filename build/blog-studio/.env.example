# NVIDIA Build API key — get from https://build.nvidia.com
# One key powers all four LLM models (Llama / DeepSeek / Gemma / Nemotron)
# and the FLUX.1-dev image endpoint.
NVIDIA_API_KEY=your_nvidia_api_key_here

# Tavily Search API key — get from https://tavily.com (free tier: 1000 queries/month)
# Used for live web-search freshness in topic generation, and by
# scripts/build-site-index.mjs to refresh the OptiFinish site index used
# for verified internal-link suggestions. Optional — the studio works
# without it, just without live-search freshness.
TAVILY_API_KEY=your_tavily_api_key_here
