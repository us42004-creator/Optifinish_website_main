# NVIDIA Build API key — get from https://build.nvidia.com
# One key powers all four LLM models (Llama / DeepSeek / Gemma / Nemotron)
# and the FLUX.1-dev image endpoint.
NVIDIA_API_KEY=your_nvidia_api_key_here

# Brave Search API key — get from https://brave.com/search/api/
# Free tier: 2,000 queries/month, 1 QPS. Used for:
#   - scripts/refresh-triggers.mjs (weekly trigger-pool refresh)
#   - topicEngine.ts (optional fresh-context injection at topic gen time)
# Leave blank to disable Brave integration — the studio falls back to the
# static 18-trigger pool without it.
BRAVE_API_KEY=your_brave_api_key_here
